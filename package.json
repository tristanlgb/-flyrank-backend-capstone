{
  "name": "flyrank-backend-ai-capstone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["week-*"],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "start:w1": "npm start -w week-01-foundations",
    "start:w2": "npm start -w week-02-task-api",
    "start:w3": "npm start -w week-03-database-api",
    "start:w4": "npm start -w week-04-auth-api",
    "start:w5": "npm start -w week-05-scraper",
    "start:w6": "npm start -w week-06-llm-api",
    "start:w7:workflow": "npm run dev -w week-07-ai-workflow",
    "start:w7:jobs": "npm start -w week-07-background-jobs",
    "start:w7:reports": "npm start -w week-07-report-generator",
    "smoke:w6-w7": "node scripts/smoke-weeks-6-7.mjs",
    "dev:w6-w7": "concurrently -n LLM,JOBS,WORKER,REPORTS,WORKFLOW \"npm run start:w6\" \"npm run start:w7:jobs\" \"npx inngest-cli@1.44.0 dev -u http://localhost:3004/api/inngest -u http://localhost:3007/api/inngest\" \"npm run start:w7:reports\" \"npm run start:w7:workflow\""
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "globals": "^16.3.0"
  },
  "engines": { "node": ">=20" }
}
